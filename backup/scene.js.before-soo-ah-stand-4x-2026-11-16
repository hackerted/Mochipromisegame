  const clips = {};
  const clipLoads = {};
  const animationFiles = {
    SooAhWalk: { url: './assets/soo-ah-walking.fbx', type: 'fbx' },
    SooAhRun: { url: './assets/animations/soo-ah/soo-ah-slow-run.fbx', type: 'fbx' },
    SooAhLookBehindRun: { url: './assets/animations/soo-ah/soo-ah-look-behind-run.fbx', type: 'fbx' },
    SooAhTurnLeft: { url: './assets/soo-ah-turn-left.fbx', type: 'fbx' },
    SooAhTurnRight: { url: './assets/soo-ah-turn-right.fbx', type: 'fbx' },
    SooAhSitToStand: { url: './assets/soo-ah-sit-to-stand.fbx', type: 'fbx' },
    SooAhStandToSit: { url: './assets/soo-ah-stand-to-sit.fbx', type: 'fbx' },
