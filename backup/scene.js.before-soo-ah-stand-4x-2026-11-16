    SooAhNervous: { url: './assets/animations/soo-ah/soo-ah-nervous-look-around.fbx', type: 'fbx' },
    SooAhTerrified: { url: './assets/animations/soo-ah/soo-ah-terrified.fbx', type: 'fbx' },
    TedWalk: { url: './assets/animations/ted/ted-walking.glb', type: 'gltf' },
