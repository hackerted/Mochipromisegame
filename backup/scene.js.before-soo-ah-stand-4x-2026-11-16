    textureLoader.loadAsync('./assets/textures/mr-lee.png'),
    textureLoader.loadAsync('./assets/textures/ted.png'),
    textureLoader.loadAsync('./assets/textures/soo-ah.png'),
    gltf(gltfLoader, './assets/props/korean_cafe.glb'),
    gltf(gltfLoader, './assets/props/cherry_tree.glb'),
